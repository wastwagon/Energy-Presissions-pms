# Coolify — set these in the Coolify environment UI

POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_first_login_password

# Public site URL (also used for REACT_APP_API_URL at frontend build)
FRONTEND_URL=https://energyprecisions.com

# Comma-separated allowed browser origins
CORS_ORIGINS=https://energyprecisions.com,https://www.energyprecisions.com

# Set true only on first deploy to run migrations + seed scripts; then false
AUTO_SEED=true

# Optional — Google Analytics 4 (requires frontend rebuild)
# REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional — add when shop checkout goes live
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
